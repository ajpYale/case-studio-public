# Required. The app looks for .env first in this folder, then in the folder above it.
PORTKEY_API_KEY=

# Optional settings (defaults shown)
# CASEGEN_MODEL=gpt-6-luna                 # the "Luna" engine: every step, every level
# CASEGEN_MODEL_STRONG=gpt-5.6-terra       # the "Stronger" engine for Easy-Hard
# CASEGEN_MODEL_INSTANT=gpt-5.6-sol        # the "Stronger" engine for Instant Offer (asks before every run)
# CASEGEN_MAX_USD_PER_CASE_LUNA=1.00       # a case stops if it would spend more than this
# CASEGEN_MAX_USD_PER_CASE_STRONG=8.00
# CASEGEN_DAILY_USD_BUDGET=10.00           # new cases are refused once today's spend reaches this
# CASEGEN_MAX_TOKENS_PER_CALL=300000       # hard cap on any single model call
# CASEGEN_PARALLEL=3                       # cases generated at the same time (1-6)
# CASEGEN_EXPORT_DIR=                      # where PDFs are saved (default: "Generated Cases")
# CASEGEN_BROWSER=                         # path to Edge/Chrome if PDF export can't find it
